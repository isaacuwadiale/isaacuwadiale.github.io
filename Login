<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><meta name="theme-color" content="#0916D5"><title>Company Login — Glouf</title>
<style>
:root{--blue:#0916D5;--yellow:#EFC80E;--ink:#111642;--muted:#667085;--line:#e4e8ff}*{box-sizing:border-box}body{margin:0;min-height:100vh;font-family:Inter,system-ui,-apple-system,"Segoe UI",sans-serif;color:var(--ink);background:radial-gradient(circle at 85% 10%,#fff1a6 0,transparent 26%),linear-gradient(135deg,#f5f6ff,#fff)}a{text-decoration:none;color:inherit}.wrap{width:min(1050px,92%);margin:auto}.nav{height:78px;display:flex;align-items:center;justify-content:space-between}.brand{font-weight:950;font-size:1.5rem;color:var(--blue);display:flex;align-items:center;gap:10px}.mark{width:32px;height:32px;border:5px solid var(--blue);border-right-color:transparent;border-radius:50%;position:relative;transform:rotate(-28deg)}.mark:after{content:"";position:absolute;width:13px;height:7px;border-left:4px solid var(--yellow);border-bottom:4px solid var(--yellow);transform:rotate(-45deg);left:6px;top:7px}.back{font-weight:750;color:var(--blue)}main{display:grid;place-items:center;padding:35px 0 70px}.card{width:min(480px,100%);background:#fff;border:1px solid var(--line);border-radius:26px;padding:clamp(24px,5vw,40px);box-shadow:0 24px 70px #10164b12}.kicker{font-size:.76rem;font-weight:850;letter-spacing:.12em;text-transform:uppercase;color:var(--blue)}h1{font-size:clamp(2rem,5vw,2.7rem);letter-spacing:-.05em;line-height:1.05;margin:12px 0}.sub{color:var(--muted);line-height:1.65;margin:0 0 26px}.field{display:flex;flex-direction:column;gap:8px;margin-bottom:18px}label{font-size:.88rem;font-weight:800}input{width:100%;border:1px solid #dce1f5;border-radius:11px;padding:14px 12px;font:inherit;color:var(--ink);outline:none}input:focus{border-color:var(--blue);box-shadow:0 0 0 3px #0916d51a}.btn{border:0;background:var(--blue);color:white;border-radius:12px;padding:15px 18px;font-weight:850;font-size:1rem;width:100%;cursor:pointer}.notice{background:#fff8d8;border:1px solid #f3df7a;color:#5b4b00;border-radius:12px;padding:13px;font-size:.84rem;line-height:1.55;margin-top:18px}.links{text-align:center;color:var(--muted);font-size:.9rem;line-height:2;margin-top:18px}.links a{color:var(--blue);font-weight:800}.footer{text-align:center;color:#777e99;font-size:.8rem;padding:0 0 28px}
</style></head><body><header class="wrap nav"><a class="brand" href="index.html"><span class="mark"></span>GLOUF</a><a class="back" href="index.html">← Homepage</a></header><main class="wrap"><section class="card"><span class="kicker">Welcome back</span><h1>Sign in to Glouf.</h1><p class="sub">Access your company dashboard to manage products or document records and check your account status.</p><form id="loginForm"><div class="field"><label for="email">Business email</label><input id="email" name="email" type="email" autocomplete="username" required placeholder="you@company.com"></div><div class="field"><label for="password">Password</label><input id="password" name="password" type="password" autocomplete="current-password" required placeholder="Enter your password"></div><button class="btn" type="submit">Sign in</button><div class="notice" id="notice"><strong>Login setup:</strong> Secure sign-in is not connected yet. This page will authenticate accounts after we connect the backend.</div></form><div class="links">Don't have a company account? <a href="register.html">Register your company</a><br><a href="index.html">Return to Glouf homepage</a></div></section></main><footer class="wrap footer">© <span id="year"></span> Glouf · A technology by Blimp International Digital Services Limited.</footer><script>document.getElementById('year').textContent=new Date().getFullYear();document.getElementById('loginForm').addEventListener('submit',function(e){e.preventDefault();document.getElementById('notice').innerHTML='<strong>Backend required.</strong> Your details have not been sent or saved. We need to connect secure authentication before sign-in can work.';});</script></body></html>
